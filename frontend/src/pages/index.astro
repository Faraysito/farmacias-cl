---
import "../styles/global.css";

const title = "Comparador de Farmacias Chile";
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <script is:inline set:html={`window.API_URL = "${API_URL}";`}></script>
  </head>
  <body class="bg-slate-50 min-h-screen">
    <div x-data="app()" x-init="init()">

      <!-- ===== HERO ===== -->
      <section class="relative overflow-hidden bg-gradient-to-br from-emerald-600 via-teal-600 to-cyan-700 text-white">
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 50%, white 1px, transparent 1px), radial-gradient(circle at 80% 80%, white 1px, transparent 1px); background-size: 40px 40px;"></div>

        <div class="relative max-w-5xl mx-auto px-4 py-12 md:py-16">
          <div class="text-center mb-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 backdrop-blur rounded-full text-xs font-medium mb-4 border border-white/20">
              <span class="w-2 h-2 bg-emerald-300 rounded-full animate-pulse"></span>
              Precios actualizados en tiempo real
            </div>
            <h1 class="text-4xl md:text-5xl font-bold mb-3 tracking-tight">
              Encuentra tu medicamento <span class="text-emerald-200">al mejor precio</span>
            </h1>
            <p class="text-lg text-emerald-50/90 max-w-2xl mx-auto">
              Comparamos Cruz Verde, Salcobrand y Ahumada en una sola búsqueda
            </p>
          </div>

          <!-- Buscador -->
          <div class="max-w-2xl mx-auto">
            <div class="flex gap-2 p-2 bg-white rounded-2xl shadow-2xl">
              <input
                type="text"
                x-model="query"
                @keyup.enter="buscar()"
                placeholder="Buscar medicamento (ej: losartan, paracetamol)"
                class="flex-1 px-4 py-3 text-slate-900 placeholder-slate-400 outline-none rounded-xl"
              />
              <button
                @click="buscar()"
                :disabled="loading"
                class="px-6 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-semibold rounded-xl hover:from-emerald-700 hover:to-teal-700 disabled:opacity-50 transition-all shadow-lg"
              >
                <span x-show="!loading">🔍 Buscar</span>
                <span x-show="loading">Buscando...</span>
              </button>
            </div>

            <!-- Chips rápidos -->
            <div class="flex flex-wrap gap-2 justify-center mt-4">
              <template x-for="c in ['losartan', 'paracetamol', 'ibuprofeno', 'omeprazol', 'atorvastatina']">
                <button
                  @click="query = c; buscar()"
                  class="px-3 py-1 bg-white/10 backdrop-blur hover:bg-white/20 border border-white/20 rounded-full text-sm transition-all"
                  x-text="c"
                ></button>
              </template>
            </div>
          </div>

          <!-- Stats -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 max-w-3xl mx-auto" x-show="stats">
            <div class="text-center">
              <div class="text-3xl font-bold" x-text="stats?.medicamentos || '...'"></div>
              <div class="text-xs text-emerald-100 uppercase tracking-wide mt-1">Medicamentos</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold" x-text="stats?.precios || '...'"></div>
              <div class="text-xs text-emerald-100 uppercase tracking-wide mt-1">Precios</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold" x-text="stats?.principios_activos || '...'"></div>
              <div class="text-xs text-emerald-100 uppercase tracking-wide mt-1">Principios activos</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold">3</div>
              <div class="text-xs text-emerald-100 uppercase tracking-wide mt-1">Cadenas</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== RESULTADOS (solo si hay) ===== -->
      <section x-show="yaBusque || loading" class="max-w-5xl mx-auto px-4 py-8">
        <template x-if="loading && lentoOnDemand">
          <div class="p-4 bg-blue-50 border border-blue-200 text-blue-800 rounded-lg text-sm mb-4">
            🔍 Buscando precios en las 3 cadenas en tiempo real. Esto puede tardar 10-15 o hasta 40 segundos por el coldstart de Render...
          </div>
        </template>

        <template x-if="error">
          <div class="p-4 bg-red-50 text-red-700 rounded-lg" x-text="error"></div>
        </template>

        <template x-if="!loading && grupos.length === 0 && yaBusque">
          <div class="text-center py-12 text-slate-500">
            Sin resultados para "<span x-text="ultimaQuery"></span>"
          </div>
        </template>

        <template x-if="grupos.length > 0">
          <div>
            <div class="text-sm text-slate-500 mb-3">
              <span x-text="grupos.length"></span> grupos para "<span x-text="ultimaQuery" class="font-semibold text-slate-700"></span>" · ordenados por precio mínimo
            </div>

            <div class="space-y-6">
              <template x-for="g in grupos" :key="g.principio_activo + (g.dosis || '')">
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                  <div class="px-5 py-3 bg-slate-50 border-b border-slate-200 flex items-baseline justify-between flex-wrap gap-2">
                    <div>
                      <h2 class="text-lg font-bold text-slate-900 capitalize" x-text="g.principio_activo"></h2>
                      <span class="text-sm text-slate-500" x-text="g.dosis || 'dosis variable'"></span>
                    </div>
                    <div class="text-xs text-slate-500">
                      <span x-text="filasDe(g).length"></span> ofertas
                    </div>
                  </div>

                  <div class="divide-y divide-slate-100">
                    <template x-for="(fila, i) in filasDe(g)" :key="fila.med_id + '-' + fila.cadena">
                      <div class="px-5 py-3 flex items-center gap-4 flex-wrap" :class="i === 0 ? 'bg-emerald-50/50' : ''">
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-slate-900 truncate" x-text="fila.nombre"></span>
                            <template x-if="i === 0">
                              <span class="px-2 py-0.5 bg-emerald-600 text-white rounded text-[10px] font-bold tracking-wide">
                                MÁS BARATO
                              </span>
                            </template>
                            <template x-if="fila.es_bio">
                              <span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-[10px] font-medium">
                                BIOEQUIVALENTE
                              </span>
                            </template>
                          </div>
                          <div class="text-xs text-slate-500 mt-0.5">
                            <span x-text="fila.laboratorio || ''"></span>
                          </div>
                        </div>

                        <div class="flex items-center gap-3 shrink-0">
                          <span class="px-2 py-1 rounded text-xs font-semibold uppercase tracking-wide" :class="claseDeCadena(fila.cadena)" x-text="labelDeCadena(fila.cadena)"></span>
                          <div class="text-xl font-bold text-slate-900 w-24 text-right" x-text="formatearPrecio(fila.precio)"></div>
                        </div>
                      </div>
                    </template>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
      </section>

      <!-- ===== CATEGORÍAS ===== -->
      <section x-show="!yaBusque" class="max-w-5xl mx-auto px-4 py-12">
        <div class="mb-8 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Busca por categoría</h2>
          <p class="text-slate-600 mt-2">Las condiciones más consultadas en farmacias chilenas</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <template x-for="cat in categorias" :key="cat.id">
            <button
              @click="query = cat.query; buscar()"
              class="group relative overflow-hidden rounded-2xl p-5 text-left transition-all hover:scale-105 hover:shadow-xl"
              :class="`bg-gradient-to-br ${cat.color}`"
            >
              <div class="text-4xl mb-3" x-text="cat.icono"></div>
              <div class="text-white font-bold text-lg" x-text="cat.nombre"></div>
              <div class="text-white/80 text-xs mt-1">ej: <span x-text="cat.query"></span></div>
              <div class="absolute top-3 right-3 text-white/40 group-hover:text-white/80 transition-colors">→</div>
            </button>
          </template>
        </div>
      </section>

      <!-- ===== TOP MEDICAMENTOS ===== -->
      <section x-show="!yaBusque && top.length > 0" class="max-w-5xl mx-auto px-4 py-12">
        <div class="mb-8 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900">🔥 Más buscados</h2>
          <p class="text-slate-600 mt-2">Medicamentos con mejor precio actualmente</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <template x-for="med in top" :key="med.id">
            <button
              @click="query = med.principio_activo; buscar()"
              class="group bg-white border border-slate-200 rounded-xl p-4 text-left hover:border-emerald-400 hover:shadow-lg transition-all"
            >
              <div class="flex items-start justify-between mb-2">
                <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded uppercase tracking-wide" x-text="med.principio_activo"></span>
                <template x-if="med.es_bioequivalente">
                  <span class="text-[10px] bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded font-bold">BIO</span>
                </template>
              </div>
              <div class="font-medium text-slate-900 truncate group-hover:text-emerald-700" x-text="med.nombre_comercial"></div>
              <div class="text-xs text-slate-500 mt-1" x-text="med.laboratorio || med.dosis"></div>
              <div class="mt-3 pt-3 border-t border-slate-100 flex items-end justify-between">
                <div>
                  <div class="text-[10px] text-slate-500 uppercase">desde</div>
                  <div class="text-xl font-bold text-emerald-600" x-text="formatearPrecio(med.precio_min)"></div>
                </div>
                <div class="text-xs text-slate-400" x-text="med.n_cadenas + (med.n_cadenas === 1 ? ' cadena' : ' cadenas')"></div>
              </div>
            </button>
          </template>
        </div>
      </section>

      <!-- ===== CÓMO FUNCIONA ===== -->
      <section x-show="!yaBusque" class="bg-white border-t border-slate-200 py-16">
        <div class="max-w-5xl mx-auto px-4">
          <div class="mb-10 text-center">
            <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Cómo funciona</h2>
            <p class="text-slate-600 mt-2">Tres pasos. Sin registros, sin ads.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="w-16 h-16 mx-auto bg-gradient-to-br from-emerald-500 to-teal-500 rounded-2xl flex items-center justify-center text-white text-2xl font-bold mb-4 shadow-lg">1</div>
              <h3 class="font-bold text-slate-900 mb-2">Buscas tu medicamento</h3>
              <p class="text-sm text-slate-600">Por nombre comercial o principio activo</p>
            </div>
            <div class="text-center">
              <div class="w-16 h-16 mx-auto bg-gradient-to-br from-teal-500 to-cyan-500 rounded-2xl flex items-center justify-center text-white text-2xl font-bold mb-4 shadow-lg">2</div>
              <h3 class="font-bold text-slate-900 mb-2">Comparamos las cadenas</h3>
              <p class="text-sm text-slate-600">Cruz Verde, Salcobrand y Ahumada en paralelo</p>
            </div>
            <div class="text-center">
              <div class="w-16 h-16 mx-auto bg-gradient-to-br from-cyan-500 to-blue-500 rounded-2xl flex items-center justify-center text-white text-2xl font-bold mb-4 shadow-lg">3</div>
              <h3 class="font-bold text-slate-900 mb-2">Ahorras dinero</h3>
              <p class="text-sm text-slate-600">Ves el más barato y los bioequivalentes</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== FOOTER ===== -->
      <footer class="bg-slate-900 text-slate-400 py-8">
        <div class="max-w-5xl mx-auto px-4 text-center text-sm">
          <p class="mb-2">Proyecto open source · FastAPI + Astro + PostgreSQL</p>
          <a href="https://github.com/Faraysito/farmacias-cl" target="_blank" class="text-emerald-400 hover:text-emerald-300">GitHub →</a>
        </div>
      </footer>

    </div>

    <script is:inline>
      const CADENAS_META = {
        cruzverde: { label: "Cruz Verde", clase: "bg-green-100 text-green-800" },
        salcobrand: { label: "Salcobrand", clase: "bg-orange-100 text-orange-800" },
        ahumada: { label: "Ahumada", clase: "bg-red-100 text-red-800" },
      };

      function app() {
        return {
          query: "",
          ultimaQuery: "",
          grupos: [],
          loading: false,
          lentoOnDemand: false,
          error: "",
          yaBusque: false,
          categorias: [],
          top: [],
          stats: null,

          async init() {
            // Carga paralela del home (no bloquea UI)
            this.cargarHome();
          },

          async cargarHome() {
            try {
              const [cR, tR, sR] = await Promise.all([
                fetch(`${window.API_URL}/api/home/categorias`),
                fetch(`${window.API_URL}/api/home/top`),
                fetch(`${window.API_URL}/api/home/stats`),
              ]);
              if (cR.ok) this.categorias = await cR.json();
              if (tR.ok) this.top = await tR.json();
              if (sR.ok) this.stats = await sR.json();
            } catch (e) {
              console.warn("No se pudo cargar el home:", e);
            }
          },

          async buscar() {
            if (this.query.trim().length < 2) {
              this.error = "Escribe al menos 2 caracteres";
              return;
            }
            this.loading = true;
            this.error = "";
            this.ultimaQuery = this.query;
            window.scrollTo({ top: 0, behavior: "smooth" });

            const slowTimeout = setTimeout(() => {
              if (this.loading) this.lentoOnDemand = true;
            }, 1500);

            try {
              const r = await fetch(
                `${window.API_URL}/api/buscar?q=${encodeURIComponent(this.query)}`
              );
              if (!r.ok) throw new Error("Error del servidor");
              this.grupos = await r.json();
              this.yaBusque = true;
            } catch (e) {
              this.error = "No se pudo conectar con el servidor. ¿Está corriendo el backend?";
              this.grupos = [];
            } finally {
              clearTimeout(slowTimeout);
              this.loading = false;
              this.lentoOnDemand = false;
            }
          },

          filasDe(grupo) {
            const filas = [];
            for (const med of grupo.medicamentos) {
              for (const p of med.precios) {
                filas.push({
                  med_id: med.id,
                  nombre: med.nombre_comercial,
                  laboratorio: med.laboratorio,
                  es_bio: med.es_bioequivalente,
                  cadena: p.cadena,
                  precio: p.precio,
                });
              }
            }
            filas.sort((a, b) => a.precio - b.precio);
            return filas;
          },
          labelDeCadena(c) { return CADENAS_META[c]?.label || c; },
          claseDeCadena(c) { return CADENAS_META[c]?.clase || "bg-slate-100 text-slate-700"; },
          formatearPrecio(p) { return "$" + p.toLocaleString("es-CL"); },
        };
      }
    </script>
  </body>
</html>