# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://farmacias:dev@localhost:5433/farmacias

# --- Feature flags ---
# 1 = no intentar scrapear Cruz Verde (deploy sin Playwright, p.ej. Render free)
DISABLE_CRUZVERDE=0

# --- Seguridad ---
# Token que protege /api/admin/scrape-top (mismo valor que el secret de GitHub Actions)
ADMIN_TOKEN=cambia-esto-por-algo-random

# --- CORS ---
# Orígenes extra permitidos, separados por coma (opcional)
EXTRA_CORS_ORIGINS=

# --- Rate limiting ---
RATE_LIMIT_BUSCAR=20/minute
RATE_LIMIT_DEFAULT=120/minute

# --- Scraper Salcobrand (Algolia, claves públicas search-only) ---
SALCOBRAND_ALGOLIA_APP_ID=GM3RP06HJG
SALCOBRAND_ALGOLIA_API_KEY=0259fe250b3be4b1326eb85e47aa7d81

# --- Alertas de precio (opcional, vía Resend) ---
# Si RESEND_API_KEY está vacío, las alertas se guardan pero no se envían correos.
RESEND_API_KEY=
ALERTAS_FROM_EMAIL=alertas@tudominio.cl
